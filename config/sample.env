# On Hermes cloud, keys live in the vault file /opt/data/.env, which the bot
# loads automatically (override path with HERMES_ENV_FILE). A project .env is
# optional; process environment variables take precedence over both.

# Alpaca credentials (paper trading) — https://app.alpaca.markets/paper
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Must be "true". Order placement refuses to run otherwise.
APCA_PAPER=true

# Advisor (advice only) — Kimi K3 via NVIDIA; config advisor.api_key_env
NVIDIA_API_KEY=

# Jev (final decision-maker) — TypeSafe AI; config jev.api_key_env
JEV_API_KEY=

# News sentiment role — config research.news_api_key_env
FINNHUB_API_KEY=
